{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.3.1",
  "id": "${TEAMS_APP_ID}",
  "developer": {
    "name": "NoteIQ",
    "websiteUrl": "${PUBLIC_URL}",
    "privacyUrl": "${PUBLIC_URL}/static/privacy.html",
    "termsOfUseUrl": "${PUBLIC_URL}/static/terms.html"
  },
  "name": {
    "short": "NoteIQ",
    "full": "NoteIQ meeting follow-ups"
  },
  "description": {
    "short": "Your meeting transcripts, Copilot notes and action items.",
    "full": "Connect your Microsoft 365 work account to view transcripts, Copilot notes and action items for meetings you organize. NoteIQ notifies you in Teams Activity when transcripts and insights are available. Requires a Microsoft 365 Copilot license and administrator-approved meeting access."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#464EB8",
  "staticTabs": [
    {
      "entityId": "meetings",
      "name": "Meetings",
      "contentUrl": "${PUBLIC_URL}/",
      "websiteUrl": "${PUBLIC_URL}/",
      "scopes": [
        "personal"
      ]
    }
  ],
  "validDomains": [
    "${PUBLIC_DOMAIN}"
  ],
  "webApplicationInfo": {
    "id": "${GRAPH_CLIENT_ID}",
    "resource": "${PUBLIC_URL}"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "TeamsActivity.Send.User",
          "type": "Application"
        }
      ]
    }
  },
  "activities": {
    "activityTypes": [
      {
        "type": "transcriptReady",
        "description": "Transcript available",
        "templateText": "{actor} has your transcript ready"
      },
      {
        "type": "insightsReady",
        "description": "Copilot insights available",
        "templateText": "{actor} has your meeting summary and action items ready"
      }
    ]
  }
}
